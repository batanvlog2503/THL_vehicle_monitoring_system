{{#if errors}}
  <h3 style="color: red;">{{errors}}</h3>
{{/if}}

<form action="/auth/update-password?token={{resetData.token}}" method="POST">
  {{! tự hiểu ngầm là new , confirm password có user_id đi cúng }}
  <input type="hidden" name="user_id" value="{{resetData.user_id}}" />

  <label for="">New Password</label>
  <br />

  <input type="password" name="password" required placeholder="New password" />
  <br />
  <label for="">Confirm Password</label>
  <br />
  <input
    type="password"
    name="c_password"
    required
    placeholder="Same new Password"
  />
  <button type="submit">Change Password</button>
</form>