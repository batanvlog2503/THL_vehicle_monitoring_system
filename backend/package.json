    "plates",
    "monitor"
  ],
  "license": "ISC",
  "author": "Pham Thanh Tan",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "beautiful": "lint-staged",
    "start": "nodemon --inspect src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
