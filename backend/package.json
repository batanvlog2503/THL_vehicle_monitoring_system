    }
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.4",
    "method-override": "^3.0.0",
    "mongoose": "^9.1.4",
    "mongoose-delete": "^1.0.7",
    "mongoose-sequence": "^6.0.1",
    "mongoose-slug-generator": "^1.0.4",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "sass": "^1.97.2"
  }
